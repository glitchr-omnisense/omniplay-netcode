<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity is not run here. The package's sources, its sample's and omniplay/dotnet's (OmniplayDotnet:
       a checkout of omniplay-dotnet) compiled together, warnings as errors, against stubs of UnityEngine
       and Netcode (Stubs/), then the sample's first call run (Program.cs). With UnityEngineDll set to a
       real UnityEngine.CoreModule.dll, the same sources compile as a netstandard2.1 library against it
       instead of the UnityEngine stub, and nothing runs. Unity ignores Tests~. -->
  <PropertyGroup>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <OmniplayDotnet Condition="'$(OmniplayDotnet)' == ''">$(MSBuildThisFileDirectory)../../.omniplay-dotnet</OmniplayDotnet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UnityEngineDll)' == ''">
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UnityEngineDll)' != ''">
    <OutputType>Library</OutputType>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(OmniplayDotnet)/Runtime/**/*.cs" />
    <Compile Include="../../Runtime/**/*.cs" />
    <Compile Include="../../Samples~/**/*.cs" />
    <Compile Include="Stubs/Netcode.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UnityEngineDll)' == ''">
    <Compile Include="Stubs/UnityEngine.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(UnityEngineDll)' != ''">
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityEngineDll)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
